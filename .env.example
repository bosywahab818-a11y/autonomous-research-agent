# Select: groq | google | anthropic
LLM_PROVIDER=groq

# Add only the key for your selected provider
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Web search
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# Generation
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
