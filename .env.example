# Select: groq | google | anthropic
LLM_PROVIDER=groq

# Add only the key for your selected provider
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Web search
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=2

# Retrieved-text limits (characters per tool response)
WEB_RESULT_MAX_CHARS=2200
ARXIV_RESULT_MAX_CHARS=1800
WIKIPEDIA_RESULT_MAX_CHARS=900

# Generation
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
