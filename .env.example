# Choose: groq | google | anthropic
LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Search
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# Optional generation settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
